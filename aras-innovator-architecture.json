    { "from": "erp", "to": "innovator", "label": "REST API" },
    { "from": "innovator", "to": "agent", "label": "タスク連携", "both": true },
    { "from": "agent", "to": "conversion", "label": "変換の依頼" },
    { "from": "scheduler", "to": "innovator", "label": "定期実行" },
